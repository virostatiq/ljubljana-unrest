{
  "name": "ljubljana-unrest",
  "version": "1.0.0",
  "description": "Cordon Bleu: crowd strategy game in the streets of real cities (Three.js WebGPU)",
  "private": true,
  "dependencies": {
    "three": "^0.186.1",
    "tone": "^15.1.22",
    "vite": "^8.3.4"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "editor": "vite --open /tools/editor/",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.sdk.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "build:city": "python tools/build_city.py",
    "build:map": "uv run --project tools/mapbuild mapbuild",
    "test:map": "uv run --project tools/mapbuild python -m unittest discover -s tools/mapbuild/tests"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "leaflet": "^1.9.4",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2"
  }
}
